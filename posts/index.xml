.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/a&gt;&#10;&lt;/h1&gt;&lt;pre&gt;&lt;code&gt;const forEach = (array, fn) =&amp;gt; {&#10; let i&#10; for (i = 0; i &amp;lt; array.length; i&amp;#43;&amp;#43;) {&#10; fn(array[i])&#10; }&#10;}&#10;&#10;let array = [1, 2, 3]&#10;forEach(array, (data) =&amp;gt; console.log(data))&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;现在我们已经看到了如何创建和执行高阶函数。 一般来说，高阶函数通常用来抽象常见的问题。 换句话说，高阶函数只不过是定义抽象。&lt;/p&gt;</description></item><item><title>JavaScript 函数编程（一）</title><link>https://zhangjinglin.github.io/2017/03/function-javascrit-01/</link><pubDate>Mon, 27 Mar 2017 05:15:08 +0000</pubDate><author>ldxyzjl@163.com (张景林)</author><guid>https://zhangjinglin.github.io/2017/03/function-javascrit-01/</guid><description>&lt;h1 class="heading-element" id="函数式编程的简单术语"&gt;&lt;span&gt;函数式编程的简单术语&lt;/span&gt;&#10; &lt;a href="#%e5%87%bd%e6%95%b0%e5%bc%8f%e7%bc%96%e7%a8%8b%e7%9a%84%e7%ae%80%e5%8d%95%e6%9c%af%e8%af%ad" class="heading-mark"&gt;&lt;svg class="octicon octicon-link" viewBox="0 0 16 16" version="1.1" width="16" height="16" aria-hidden="true"&gt;&lt;path d="m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/a&gt;&#10;&lt;/h1&gt;&lt;h2 class="heading-element" id="什么是函数式编程为什么很重要"&gt;&lt;span&gt;什么是函数式编程？为什么很重要？&lt;/span&gt;&#10; &lt;a href="#%e4%bb%80%e4%b9%88%e6%98%af%e5%87%bd%e6%95%b0%e5%bc%8f%e7%bc%96%e7%a8%8b%e4%b8%ba%e4%bb%80%e4%b9%88%e5%be%88%e9%87%8d%e8%a6%81" class="heading-mark"&gt;&lt;svg class="octicon octicon-link" viewBox="0 0 16 16" version="1.1" width="16" height="16" aria-hidden="true"&gt;&lt;path d="m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/a&gt;&#10;&lt;/h2&gt;&lt;p&gt;数学中的函数&lt;/p&gt;</description></item><item><title>(FMS03)Vim 的插件</title><link>https://zhangjinglin.github.io/2016/12/fms03-vim02-md/</link><pubDate>Sat, 03 Dec 2016 05:47:01 +0000</pubDate><author>ldxyzjl@163.com (张景林)</author><guid>https://zhangjinglin.github.io/2016/12/fms03-vim02-md/</guid><description>&lt;p&gt;Vim 除了强大的键盘模式以外, Vim 还有插件功能, 可以通过插件将 Vim 的功能增强, 经过多年的发展, Vim 的插件系统有着庞大的规模, 有很多号称神级的插件, 是很多编辑器的模仿对象.&lt;/p&gt;</description></item><item><title>(FMS02)Vim 安装与配置</title><link>https://zhangjinglin.github.io/2016/12/FMS02-vim01/</link><pubDate>Thu, 01 Dec 2016 08:11:19 +0000</pubDate><author>ldxyzjl@163.com (张景林)</author><guid>https://zhangjinglin.github.io/2016/12/FMS02-vim01/</guid><description>&lt;p&gt;编辑器之神 Vim 的安装与简单配置&lt;/p&gt;&#10;&lt;h2 class="heading-element" id="安装"&gt;&lt;span&gt;安装&lt;/span&gt;&#10; &lt;a href="#%e5%ae%89%e8%a3%85" class="heading-mark"&gt;&lt;svg class="octicon octicon-link" viewBox="0 0 16 16" version="1.1" width="16" height="16" aria-hidden="true"&gt;&lt;path d="m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/a&gt;&#10;&lt;/h2&gt;&lt;pre&gt;&lt;code&gt;brew update //升级 brew 到最新版本&#10;brew info vim //查看 vim 包的配置信息&#10;brew install vim --with-lua //安装 brew, 同时安装 lua 支持, 我们的一些插件需要 lua 的支持&#10;//下载, 配置, 编译&#10;&#10;mvim //启动 vim 图形界面, 也可以执行 vim 进入字符界面, 我们用 macOS 要享受图形界面的美观&lt;/code&gt;&lt;/pre&gt;&lt;h3 class="heading-element" id="配置"&gt;&lt;span&gt;配置&lt;/span&gt;&#10; &lt;a href="#%e9%85%8d%e7%bd%ae" class="heading-mark"&gt;&lt;svg class="octicon octicon-link" viewBox="0 0 16 16" version="1.1" width="16" height="16" aria-hidden="true"&gt;&lt;path d="m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/a&gt;&#10;&lt;/h3&gt;&lt;p&gt;初看 vim 你肯定傻眼了, 啥么玩意, 这界面太古老了. 我们需要配置才能让 vim 符合我们自己的审美观点.&lt;/p&gt;</description></item><item><title>(FMS01)Homebrew - macOS 不可或缺的套件管理器</title><link>https://zhangjinglin.github.io/2016/12/FMS01-brew/</link><pubDate>Thu, 01 Dec 2016 08:08:34 +0000</pubDate><author>ldxyzjl@163.com (张景林)</author><guid>https://zhangjinglin.github.io/2016/12/FMS01-brew/</guid><description>&lt;p&gt;macOS 的内核基于 unix 的变种 FreeBSD 来进行开发的, 在内核上面配有苹果公司漂亮的图形界面. 因为 macOS 是基于 unix 变种的, 所以 macOS 在程序员中特别流行. 近年来, 新的软件技术和严肃的程序开发, 大部分在 unix 中或者类 unix 的 Linux 中完成, 而 macOS 天生的 unix 基因, 使得 macOS 也得到了很多便利. 但 macOS 毕竟不是 Linux, 使得很多 Linux 下的优秀软件没有在 macOS 下进行实现, 而 Homebrew 则填补了这方面的空白.&lt;/p&gt;</description></item><item><title>线性代数(八) - 线性方程组(三)</title><link>https://zhangjinglin.github.io/2016/11/xxds08/</link><pubDate>Sun, 27 Nov 2016 06:26:24 +0000</pubDate><author>ldxyzjl@163.com (张景林)</author><guid>https://zhangjinglin.github.io/2016/11/xxds08/</guid><description>&lt;p&gt;大连理工大学 施光燕教授 线性代数笔记&lt;/p&gt;&#10;&lt;p&gt;因为 Hexo 对 TeX 数学公式解析问题,采用 pdf 文件形式.&lt;/p&gt;&#10;&lt;p&gt;&lt;a href="https://zhangjinglin.github.io/2016/11/xxds08/xxds-8.pdf"&gt;线性代数-线性方程组(三).pdf&lt;/a&gt;&lt;/p&gt;</description></item><item><title>线性代数(七) - 线性方程组(二)</title><link>https://zhangjinglin.github.io/2016/11/xxds07/</link><pubDate>Sun, 27 Nov 2016 05:26:24 +0000</pubDate><author>ldxyzjl@163.com (张景林)</author><guid>https://zhangjinglin.github.io/2016/11/xxds07/</guid><description>&lt;p&gt;大连理工大学 施光燕教授 线性代数笔记&lt;/p&gt;&#10;&lt;p&gt;因为 Hexo 对 TeX 数学公式解析问题,采用 pdf 文件形式.&lt;/p&gt;&#10;&lt;p&gt;&lt;a href="https://zhangjinglin.github.io/2016/11/xxds07/xxds-7.pdf"&gt;线性代数-线性方程组(二).pdf&lt;/a&gt;&lt;/p&gt;</description></item><item><title>线性代数(六) - 线性方程组(一)</title><link>https://zhangjinglin.github.io/2016/11/xxds06/</link><pubDate>Sun, 27 Nov 2016 04:26:24 +0000</pubDate><author>ldxyzjl@163.com (张景林)</author><guid>https://zhangjinglin.github.io/2016/11/xxds06/</guid><description>&lt;p&gt;大连理工大学 施光燕教授 线性代数笔记&lt;/p&gt;&#10;&lt;p&gt;因为 Hexo 对 TeX 数学公式解析问题,采用 pdf 文件形式.&lt;/p&gt;&#10;&lt;p&gt;&lt;a href="https://zhangjinglin.github.io/2016/11/xxds06/xxds-6.pdf"&gt;线性代数-线性方程组(一).pdf&lt;/a&gt;&lt;/p&gt;</description></item><item><title>线性代数(五) - 向量</title><link>https://zhangjinglin.github.io/2016/11/xxds05/</link><pubDate>Sun, 27 Nov 2016 